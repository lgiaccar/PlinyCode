{
	"name": "plinycode-dev",
	"displayName": "PlinyCode",
	"description": "Synopsys Pliny coding agent for VS Code / Cursor — internal models only via the Pliny gateway.",
	"version": "0.1.8",
	"icon": "assets/icons/icon.png",
	"engines": {
		"vscode": "^1.101.0"
	},
	"author": {
		"name": "Synopsys"
	},
	"license": "Apache-2.0",
	"publisher": "synopsys-plinycode",
	"repository": {
		"type": "git",
		"url": "https://github.com/lgiaccar/PlinyCode"
	},
	"homepage": "https://github.com/lgiaccar/PlinyCode",
	"categories": [
		"AI",
		"Chat",
		"Programming Languages",
		"Education",
		"Snippets",
		"Testing"
	],
	"keywords": [
		"pliny",
		"plinycode",
		"synopsys",
		"cline",
		"coding",
		"agent",
		"autonomous",
		"ai"
	],
	"activationEvents": [
		"onLanguage",
		"onUri",
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"mcpServerDefinitionProviders": [
			{
				"id": "plinycode.devops",
				"label": "PlinyCode DevOps"
			}
		],
		"icons": {
			"cline-icon": {
				"description": "cline",
				"default": {
					"fontPath": "assets/icons/cline-bot.woff",
					"fontCharacter": "\\e900"
				}
			}
		},
		"walkthroughs": [
			{
				"id": "ClineWalkthrough",
				"title": "Meet PlinyCode, your new coding partner",
				"description": "PlinyCode codes like a developer because it thinks like one. Here are 5 ways to put it to work:",
				"steps": [
					{
						"id": "welcome",
						"title": "Start with a Goal, Not Just a Prompt",
						"description": "Tell PlinyCode what you want to achieve. It plans, asks, and then codes, like a true partner.",
						"media": {
							"markdown": "walkthrough/step1.md"
						}
					},
					{
						"id": "learn",
						"title": "Let PlinyCode Learn Your Codebase",
						"description": "Point PlinyCode to your project. It builds understanding to make smart, context-aware changes.",
						"media": {
							"markdown": "walkthrough/step2.md"
						}
					},
					{
						"id": "advanced-features",
						"title": "The Right Pliny Model for Every Task",
						"description": "Pick a Synopsys internal model, or let FreeAuto and BalanceAuto choose one for each step.",
						"media": {
							"markdown": "walkthrough/step3.md"
						}
					},
					{
						"id": "mcp",
						"title": "Extend with Powerful Tools (MCP)",
						"description": "Connect to databases, APIs, and other external tools through MCP.",
						"media": {
							"markdown": "walkthrough/step4.md"
						}
					},
					{
						"id": "getting-started",
						"title": "You're Always in Control",
						"description": "Review PlinyCode's plans and diffs. Approve changes before they happen. No surprises.",
						"media": {
							"markdown": "walkthrough/step5.md"
						},
						"content": {
							"path": "walkthrough/step5.md"
						}
					}
				]
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "plinycode-dev-ActivityBar",
					"title": "PlinyCode",
					"icon": "assets/icons/icon.svg"
				}
			]
		},
		"views": {
			"plinycode-dev-ActivityBar": [
				{
					"type": "webview",
					"id": "plinycode-dev.SidebarProvider",
					"name": "",
					"icon": "assets/icons/icon.svg"
				}
			]
		},
		"commands": [
			{
				"command": "cline.plusButtonClicked",
				"title": "New Task",
				"icon": "$(add)"
			},
			{
				"command": "cline.mcpButtonClicked",
				"title": "MCP Servers",
				"icon": "$(server)"
			},
			{
				"command": "cline.historyButtonClicked",
				"title": "History",
				"icon": "$(history)"
			},
			{
				"command": "cline.settingsButtonClicked",
				"title": "Settings",
				"icon": "$(settings-gear)"
			},
			{
				"command": "cline.dev.createTestTasks",
				"title": "Create Test Tasks",
				"category": "PlinyCode",
				"when": "cline.isDevMode"
			},
			{
				"command": "cline.dev.expireMcpOAuthTokens",
				"title": "Expire MCP OAuth Tokens (for testing)",
				"category": "PlinyCode",
				"when": "cline.isDevMode"
			},
			{
				"command": "cline.addToChat",
				"title": "Add to PlinyCode",
				"category": "PlinyCode"
			},
			{
				"command": "cline.addTerminalOutputToChat",
				"title": "Add to PlinyCode",
				"category": "PlinyCode"
			},
			{
				"command": "cline.focusChatInput",
				"title": "Jump to Chat Input",
				"category": "PlinyCode"
			},
			{
				"command": "cline.generateGitCommitMessage",
				"title": "Generate Commit Message with PlinyCode",
				"category": "PlinyCode",
				"icon": "$(cline-icon)"
			},
			{
				"command": "cline.openFreeAutoRules",
				"title": "Open Routing Rules (auto-free / auto-paid-balanced)",
				"category": "PlinyCode"
			},
			{
				"command": "cline.openFreeAutoCallLog",
				"title": "Open Router Call Log (auto-free / auto-paid-balanced)",
				"category": "PlinyCode"
			},
			{
				"command": "cline.checkForUpdates",
				"title": "Check for Updates",
				"category": "PlinyCode"
			},
			{
				"command": "cline.exportTaskToMarkdown",
				"title": "Export Conversation as Markdown",
				"category": "PlinyCode"
			},
			{
				"command": "cline.abortGitCommitMessage",
				"title": "Generate Commit Message with PlinyCode - Stop",
				"category": "PlinyCode",
				"icon": "$(debug-stop)"
			},
			{
				"command": "cline.explainCode",
				"title": "Explain with PlinyCode",
				"category": "PlinyCode"
			},
			{
				"command": "cline.improveCode",
				"title": "Improve with PlinyCode",
				"category": "PlinyCode"
			},
			{
				"command": "cline.jupyterGenerateCell",
				"title": "Generate Jupyter Cell with PlinyCode",
				"category": "PlinyCode",
				"icon": "$(sparkle)"
			},
			{
				"command": "cline.jupyterExplainCell",
				"title": "Explain Jupyter Cell with PlinyCode",
				"category": "PlinyCode",
				"icon": "$(question)"
			},
			{
				"command": "cline.jupyterImproveCell",
				"title": "Improve Jupyter Cell with PlinyCode",
				"category": "PlinyCode",
				"icon": "$(lightbulb)"
			},
			{
				"command": "cline.openWalkthrough",
				"title": "Open Walkthrough",
				"category": "PlinyCode"
			}
		],
		"keybindings": [
			{
				"command": "cline.addToChat",
				"key": "cmd+'",
				"mac": "cmd+'",
				"win": "ctrl+'",
				"linux": "ctrl+'",
				"when": "editorHasSelection"
			},
			{
				"command": "cline.generateGitCommitMessage",
				"when": "config.git.enabled && scmProvider == git"
			},
			{
				"command": "cline.focusChatInput",
				"key": "cmd+'",
				"mac": "cmd+'",
				"win": "ctrl+'",
				"linux": "ctrl+'",
				"when": "!editorHasSelection"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "cline.plusButtonClicked",
					"group": "navigation@1",
					"when": "view == plinycode-dev.SidebarProvider"
				},
				{
					"command": "cline.mcpButtonClicked",
					"group": "navigation@2",
					"when": "view == plinycode-dev.SidebarProvider"
				},
				{
					"command": "cline.historyButtonClicked",
					"group": "navigation@3",
					"when": "view == plinycode-dev.SidebarProvider"
				},
				{
					"command": "cline.settingsButtonClicked",
					"group": "navigation@6",
					"when": "view == plinycode-dev.SidebarProvider"
				}
			],
			"editor/context": [
				{
					"command": "cline.addToChat",
					"group": "navigation",
					"when": "editorHasSelection"
				}
			],
			"terminal/context": [
				{
					"command": "cline.addTerminalOutputToChat",
					"group": "navigation"
				}
			],
			"scm/title": [
				{
					"command": "cline.generateGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && !cline.isGeneratingCommit"
				},
				{
					"command": "cline.abortGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && cline.isGeneratingCommit"
				}
			],
			"notebook/toolbar": [
				{
					"command": "cline.jupyterGenerateCell",
					"group": "navigation/add@1",
					"when": "notebookType == 'jupyter-notebook'"
				}
			],
			"notebook/cell/title": [
				{
					"command": "cline.jupyterExplainCell",
					"group": "inline@1",
					"when": "notebookType == 'jupyter-notebook'"
				},
				{
					"command": "cline.jupyterImproveCell",
					"group": "inline@2",
					"when": "notebookType == 'jupyter-notebook'"
				}
			],
			"commandPalette": [
				{
					"command": "cline.generateGitCommitMessage",
					"when": "config.git.enabled && !cline.isGeneratingCommit"
				},
				{
					"command": "cline.abortGitCommitMessage",
					"when": "config.git.enabled && cline.isGeneratingCommit"
				}
			]
		},
		"configuration": {
			"title": "PlinyCode",
			"properties": {
				"plinycode.context.editorState": {
					"type": "boolean",
					"default": true,
					"description": "Tell the model what you are looking at: with each message you send, PlinyCode adds the active file, the cursor line or selected lines, and the open tabs (up to 20). File contents are not included, and the chat does not show the addition."
				},
				"plinycode.context.gitSnapshot": {
					"type": "boolean",
					"default": true,
					"description": "Tell the model the state of the git repository when a conversation starts: the current and default branch, a short status (up to 20 entries) and the last 5 commits. The snapshot is taken once per conversation and is not updated afterwards."
				},
				"plinycode.devops.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Run the built-in PlinyCode DevOps MCP server, which lets the agent create and update pull requests and read CI pipeline results on GitHub and Azure DevOps."
				},
				"plinycode.devops.registerWithEditor": {
					"type": "boolean",
					"default": true,
					"description": "Also offer the PlinyCode DevOps MCP server to the editor's own AI chat: Copilot Chat agent mode in VS Code, or the agent in Cursor."
				},
				"plinycode.spending.conversationLimit": {
					"type": "number",
					"default": 5,
					"minimum": 0,
					"markdownDescription": "The budget, in US dollars, that each new conversation starts with. The task header shows a conversation's cost against its budget, and you can change one conversation's budget there. When a conversation reaches its budget, PlinyCode pauses before the next model call; send a message to continue, which raises that conversation's budget by this amount. Free models and the auto-free routers are never limited. Set to `0` for no limit."
				},
				"plinycode.updates.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Automatically install new PlinyCode releases from GitHub. Checks shortly after startup and every 6 hours."
				},
				"plinycode.updates.prerelease": {
					"type": "boolean",
					"default": false,
					"scope": "application",
					"markdownDescription": "Also install PlinyCode **pre-releases** (e.g. `0.1.4-test.1`) from GitHub, for developers and testers. Leave off to get official releases only (e.g. `0.1.4`). Turning it off never downgrades: a pre-release you already have stays until a newer official release replaces it."
				},
				"plinycode.updates.url": {
					"type": "string",
					"default": "https://github.com/lgiaccar/PlinyCode/releases/latest/download/latest.json",
					"description": "URL of the latest.json that describes the newest official PlinyCode release. Leave empty to use the default GitHub URL."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "bun run package",
		"build": "bun run build:webview && bun esbuild.mjs",
		"typecheck": "bun run check-types",
		"compile": "bun run check-types && bun run lint && bun esbuild.mjs",
		"dev": "bun run protos && bun run watch",
		"watch": "bun run --parallel watch:esbuild watch:tsc",
		"watch:esbuild": "bun esbuild.mjs --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "bun run check-types && bun run build:webview && bun run lint && bun esbuild.mjs --production",
		"release:package": "bun scripts/release.ts package",
		"release:publish": "bun scripts/release.ts publish",
		"protos": "node scripts/build-proto.mjs",
		"postprotos": "biome format --config-path ./biome.jsonc src/shared/proto src/core/controller src/hosts/ webview-ui/src/services src/generated --write --no-errors-on-unmatched",
		"clean:build": "rimraf dist webview-ui/build src/generated out/",
		"clean:deps": "rimraf node_modules webview-ui/node_modules",
		"clean:all": "bun run clean:build && bun run clean:deps",
		"compile-tests": "node ./scripts/build-tests.js",
		"watch-tests": "tsc -p . -w --outDir out",
		"check-types": "bun run protos && bunx tsc --noEmit && bun run check-types:compat && cd webview-ui && bunx tsc -b --force",
		"check-types:compat": "bunx tsc --project tsconfig.vscode-compat.json --noEmit",
		"lint": "biome lint --config-path ./biome.jsonc --no-errors-on-unmatched --files-ignore-unknown=true --diagnostic-level=error && bun run lint:proto",
		"lint:proto": "bash ./scripts/proto-lint.sh",
		"analyze:unused": "bunx --yes knip@5.88.1 --config knip.json --include files,exports,types,enumMembers,duplicates",
		"analyze:unused:prod": "bunx --yes knip@5.88.1 --config knip.json --production --include files,exports,types,enumMembers,dependencies",
		"format": "biome format --config-path ./biome.jsonc --no-errors-on-unmatched --files-ignore-unknown=true --diagnostic-level=error --semicolons=as-needed",
		"format:fix": "biome check --config-path ./biome.jsonc --changed --since main --no-errors-on-unmatched --files-ignore-unknown=true --write --semicolons=as-needed",
		"fix:all": "biome check --config-path ./biome.jsonc --no-errors-on-unmatched --files-ignore-unknown=true --write --diagnostic-level=error --unsafe --semicolons=as-needed",
		"ci:check-all": "bun run --parallel check-types lint format",
		"ci:build": "bun run protos && bun run build:webview && bun esbuild.mjs && bun run compile-tests",
		"pretest": "bun run compile && bun run compile-tests && bun run lint",
		"test": "bun run test:unit && bun run test:integration",
		"test:integration": "bun run compile-tests && vscode-test",
		"test:unit": "bun scripts/run-bun-unit-tests.ts",
		"test:vitest": "vitest run --config vitest.config.ts",
		"test:vitest:watch": "vitest --config vitest.config.ts",
		"test:bun": "bun scripts/run-bun-tests.ts",
		"test:bun:unit": "bun scripts/run-bun-unit-tests.ts",
		"test:coverage": "bun run compile-tests && vscode-test --coverage",
		"dev:mcp-oauth-test-server": "bun src/dev/mcp-oauth-test-server/server.ts",
		"e2e": "playwright test -c playwright.config.ts",
		"test:e2e:build": "vsce package --no-dependencies --allow-package-secrets sendgrid --out dist/e2e.vsix",
		"test:e2e": "playwright install && bun run test:e2e:build && node src/test/e2e/utils/build.mjs && playwright test",
		"test:e2e:optimal": "bun run test:e2e:build && node src/test/e2e/utils/build.mjs && playwright test",
		"test:e2e:ui": "bun scripts/interactive-playwright.ts",
		"install:all": "bun install",
		"dev:webview": "node scripts/clean-webview-vite-cache.mjs && cd webview-ui && bun run dev",
		"build:webview": "bun run protos && cd webview-ui && bun run build",
		"test:webview": "cd webview-ui && bun run test",
		"storybook": "cd webview-ui && bun run storybook"
	},
	"lint-staged": {
		"src/shared/storage/state-keys.ts": [
			"node scripts/generate-state-proto.mjs",
			"git add apps/vscode/proto/cline/state.proto"
		],
		"*": [
			"biome check --write --staged --no-errors-on-unmatched --files-ignore-unknown=true --semicolons=as-needed"
		]
	},
	"devDependencies": {
		"@anthropic-ai/sdk": "^0.37.0",
		"@biomejs/biome": "^2.3.14",
		"@bufbuild/buf": "^1.54.0",
		"@grpc/grpc-js": "^1.9.15",
		"@grpc/proto-loader": "^0.7.13",
		"@playwright/test": "^1.55.1",
		"@types/chai": "^5.0.1",
		"@types/js-yaml": "^4.0.9",
		"@types/mocha": "^10.0.7",
		"@types/node": "22.15.1",
		"@types/pdf-parse": "^1.1.4",
		"@types/picomatch": "^4.0.2",
		"@types/should": "^11.2.0",
		"@types/sinon": "^21.0.0",
		"@types/turndown": "^5.0.5",
		"@types/vscode": "1.101.0",
		"@vscode/test-cli": "^0.0.12",
		"@vscode/test-electron": "^2.5.2",
		"@vscode/vsce": "^3.6.0",
		"chai": "^4.3.10",
		"chalk": "5.6.2",
		"esbuild": "^0.25.0",
		"globby": "^14.0.2",
		"grpc-tools": "^1.13.0",
		"lint-staged": "^16.1.0",
		"mocha": "^11.7.4",
		"playwright": "^1.55.1",
		"rimraf": "^6.0.1",
		"should": "^13.2.3",
		"sinon": "^21.0.3",
		"ts-morph": "^25.0.1",
		"ts-proto": "^2.6.1",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	},
	"dependencies": {
		"@bufbuild/protobuf": "^2.2.5",
		"@plinycode/core": "workspace:*",
		"@plinycode/llms": "workspace:*",
		"@plinycode/shared": "workspace:*",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@vscode/codicons": "^0.0.36",
		"axios": "1.18.0",
		"cheerio": "^1.0.0",
		"chokidar": "^4.0.1",
		"diff": "8.0.4",
		"exceljs": "^4.4.0",
		"execa": "^9.5.2",
		"fast-deep-equal": "^3.1.3",
		"fzf": "^0.5.2",
		"get-folder-size": "^5.0.0",
		"iconv-lite": "^0.6.3",
		"image-size": "^2.0.2",
		"isbinaryfile": "^5.0.2",
		"js-yaml": "^4.1.1",
		"jschardet": "^3.1.4",
		"json5": "^2.2.3",
		"mammoth": "^1.11.0",
		"node-machine-id": "^1.1.12",
		"open": "^10.1.2",
		"open-graph-scraper": "^6.9.0",
		"p-wait-for": "^5.0.2",
		"pdf-parse": "^1.1.1",
		"picomatch": "^4.0.3",
		"puppeteer-chromium-resolver": "^23.0.0",
		"puppeteer-core": "^23.4.0",
		"reconnecting-eventsource": "^1.6.4",
		"serialize-error": "^11.0.3",
		"turndown": "^7.2.0",
		"undici": "^7.29.0",
		"uuid": "^11.1.0",
		"vscode-uri": "^3.1.0",
		"zod": "^4.3.6"
	},
	"c8": {
		"reporter": [
			"lcov",
			"html"
		],
		"exclude": [
			"**/webview-ui/**",
			"**/.vscode-test/**",
			"**/node_modules/**",
			"node_modules",
			"**/*.d.ts",
			"**/*.{test,spec}.{js,jsx,ts,tsx,mjs,cjs}",
			"**/__tests__/**",
			"**/test/**",
			"**/tests/**",
			"**/.nyc_output/**",
			"**/tests-results/**",
			"src/test/**",
			"**/src/xml/**",
			"**/src/generated/**",
			"dist"
		],
		"all": true,
		"exclude-after-remap": true
	}
}
