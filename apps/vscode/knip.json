{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"workspaces": {
		".": {
			"entry": [
				"src/extension.ts!",
				"src/services/devops-mcp/server/main.ts!",
				"src/generated/hosts/vscode/protobus-services.ts!",
				"src/generated/hosts/vscode/hostbridge-grpc-service-config.ts!",
				"src/dev/debug-harness/server.ts",
				"src/dev/mcp-oauth-test-server/server.ts",
				"src/**/*.test.ts",
				"src/**/__tests__/**/*.ts",
				"src/test/**/*.ts"
			],
			"project": [
				"src/**/*.ts!"
			],
			"ignoreDependencies": [
				"@plinycode/core",
				"@plinycode/llms",
				"@plinycode/shared"
			]
		},
		"webview-ui": {
			"entry": [
				"src/main.tsx!",
				"src/services/grpc-client.ts!",
				"src/**/*.test.{ts,tsx}",
				"src/**/*.spec.{ts,tsx}",
				"src/**/__tests__/**/*.{ts,tsx}"
			],
			"project": [
				"src/**/*.{ts,tsx}!",
				"*.ts"
			],
			"ignoreDependencies": [
				"@plinycode/shared"
			],
			"vite": true
		}
	}
}
